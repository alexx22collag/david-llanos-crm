# Copia este archivo a .env.local. Cambia a google después de completar los datos.
CRM_MODE=demo
CRM_ORIGIN=http://127.0.0.1:4174
CRM_ADMIN_EMAIL=admin@example.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
CRM_DB_PATH=.local/workspace.sqlite
CRM_BIND=127.0.0.1
PORT=4174
# Opcional. Para acceso con enlace por email, configura un remitente verificado en Resend.
RESEND_API_KEY=
CRM_EMAIL_FROM=
